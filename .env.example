# Copy to .env and replace every value marked change-me. .env is never committed.
# Each phase adds the variables it reads (ADR-013).
# Write values without quotes and without \ or $: Docker Compose and the backend's dev profile
# (a properties file) read those characters differently, and the database login then fails.

# Database (Compose service "db")
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me

# Product name shown in the interface (D1, ADR-007, ADR-039).
APP_DISPLAY_NAME=Pramaan

# Signs the access tokens (AUTH-6): base64 of at least 32 random bytes. Generate one as the README
# shows. change-me is not a valid key on purpose, so the backend does not start until you set one.
APP_SECURITY_JWT_SECRET=change-me

# Where you open the interface. Only these origins may use the refresh cookie (AUTH-9).
# Comma-separated, never *.
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000

# The first admin account, created at startup only while no admin exists (AUTH-3). There is no
# built-in account. The password needs 10 to 128 characters; change-me is too short on purpose, so
# the backend does not start until you set a real one. Sign in with this email and password.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Optional, comma-separated, for example uni.example. Empty: anyone may register, always as a
# student (AUTH-1).
APP_REGISTRATION_ALLOWED_EMAIL_DOMAINS=

# Optional: the largest PDF that can be uploaded (DOC-1), 25MB unless set. nginx accepts request
# bodies up to 30MB, so values above about 29MB need nginx.conf changed too. Remove the # to set it;
# an empty value would stop the backend from starting.
# APP_UPLOAD_MAX_FILE_SIZE=25MB

# The embedding model (D6, ADR-033) runs in Ollama on this machine, not in Compose, so it can use
# the GPU. Install Ollama and run `ollama pull qwen3-embedding:0.6b` once. The backend started on
# the host uses OLLAMA_BASE_URL; the backend container uses OLLAMA_BASE_URL_FROM_CONTAINER.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL_FROM_CONTAINER=http://host.docker.internal:11434
# Changing the model or its dimension needs a full re-index; the backend refuses to start while
# indexed documents come from another model.
APP_EMBEDDING_MODEL=qwen3-embedding:0.6b
APP_EMBEDDING_DIMENSIONS=1024

# The chat model that answers questions (D5, ADR-036): OpenAI's Chat Completions API, billed per
# token. Reasoning tokens are billed as output, so reasoning effort stays none. With a hosted model
# the text of the passages used for an answer leaves this machine (SEC-13): use public documents.
# The backend does not start with the openai provider and no key. CHAT_PROVIDER=none runs
# everything except answering questions.
CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
